# ReelEel environment. Copy to .env and edit; .env is gitignored.
# Every value here is optional — ReelEel runs fully local with none of them set.

# ── Storage ─────────────────────────────────────────────────────────────────
# Project databases are ALWAYS local files. These settings only affect the
# machine-wide registry (which projects and models this install knows about).
# Leave unset for a plain local file and no network access at all.
#
# REELEEL_DB_URL=libsql://your-database.turso.io
# REELEEL_DB_AUTH_TOKEN=
#
# With a remote URL set, ReelEel uses an embedded replica: reads stay local and
# offline-safe, writes push through when there is a connection.
# REELEEL_DB_REPLICA_PATH=
# REELEEL_DB_SYNC_INTERVAL=60
#
# Force a specific local file instead (used by scripts/db-migrate.mjs).
# REELEEL_DB_PATH=

# ── Paths ───────────────────────────────────────────────────────────────────
# Override the config/data/cache root. Handy for tests, portable installs, and
# containers (the Docker image sets this to /data and mounts it as a volume).
# REELEEL_HOME=

# Where `project create` puts new projects. Defaults to ~/ReelEel, which is
# ephemeral inside a container — point it at a mounted volume there.
# REELEEL_PROJECTS_DIR=

# Default project for CLI commands, so you can skip --project.
# REELEEL_PROJECT=

# ── FFmpeg ──────────────────────────────────────────────────────────────────
# Only needed when the binaries are not on PATH.
# REELEEL_FFMPEG=/usr/bin/ffmpeg
# REELEEL_FFPROBE=/usr/bin/ffprobe

# ── CV worker ───────────────────────────────────────────────────────────────
# Point at an executable that speaks the protocol in workers/cv/README.md.
# REELEEL_CV_WORKER=
# REELEEL_PYTHON=python3

# ── Servers ─────────────────────────────────────────────────────────────────
# Both bind to loopback by default; they can read and delete local project
# directories, so exposing them has to be deliberate.
# PORT=8788
# HOST=127.0.0.1

# ── Debugging ───────────────────────────────────────────────────────────────
# REELEEL_DEBUG=1
