# ReelEel environment. Copy to .env and edit; .env is gitignored.
# Every value here is optional — ReelEel runs fully local with none of them set.

# ── Authentication ──────────────────────────────────────────────────────────
# Service token for scripts and operators. It is NOT scoped to an account: it
# sees every project on the machine, so treat it as an admin credential.
#
# The server REFUSES TO START if it would listen on a non-loopback interface
# without this set, because it can read, modify and delete project directories.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# REELEEL_AUTH_TOKEN=
#
# How long a browser session cookie lasts. Default 7 days.
# REELEEL_SESSION_SECONDS=604800
#
# Accounts: users register at /register and only ever see their own projects.
# Close registration once your people have signed up.
# REELEEL_ALLOW_SIGNUP=true
#
# Require a confirmed email before an account can use the app. Defaults to on
# when RESEND_API_KEY is set and off when it is not, so a self-hosted install
# without email is not locked out of itself.
# REELEEL_REQUIRE_EMAIL_VERIFICATION=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Sends verification and password-reset links. With no key, links are written
# to the server log instead — fine for local development, useless in production.
# The sending domain must be verified in Resend or every send is rejected.
# RESEND_API_KEY=
# REELEEL_EMAIL_FROM=ReelEel <noreply@example.com>
#
# Absolute base for links in emails. Without it, the request's own origin is
# used, which is wrong behind a proxy that rewrites the host.
# REELEEL_PUBLIC_URL=https://example.com

# ── Storage ─────────────────────────────────────────────────────────────────
# Project databases are ALWAYS local files. These settings only affect the
# machine-wide registry (which projects and models this install knows about).
# Leave unset for a plain local file and no network access at all.
#
# REELEEL_DB_URL=libsql://your-database.turso.io
# REELEEL_DB_AUTH_TOKEN=
#
# With a remote URL set, ReelEel uses an embedded replica: reads stay local and
# offline-safe, writes push through when there is a connection.
# REELEEL_DB_REPLICA_PATH=
# REELEEL_DB_SYNC_INTERVAL=60
#
# Force a specific local file instead (used by scripts/db-migrate.mjs).
# REELEEL_DB_PATH=

# ── Paths ───────────────────────────────────────────────────────────────────
# Override the config/data/cache root. Handy for tests, portable installs, and
# containers (the Docker image sets this to /data and mounts it as a volume).
# REELEEL_HOME=

# Where `project create` puts new projects. Defaults to ~/ReelEel, which is
# ephemeral inside a container — point it at a mounted volume there.
# REELEEL_PROJECTS_DIR=

# Default project for CLI commands, so you can skip --project.
# REELEEL_PROJECT=

# ── FFmpeg ──────────────────────────────────────────────────────────────────
# Only needed when the binaries are not on PATH.
# REELEEL_FFMPEG=/usr/bin/ffmpeg
# REELEEL_FFPROBE=/usr/bin/ffprobe

# ── CV worker ───────────────────────────────────────────────────────────────
# Point at an executable that speaks the protocol in workers/cv/README.md.
# REELEEL_CV_WORKER=
# REELEEL_PYTHON=python3

# ── Servers ─────────────────────────────────────────────────────────────────
# Both bind to loopback by default; they can read and delete local project
# directories, so exposing them has to be deliberate.
# PORT=8788
# HOST=127.0.0.1

# ── Uploads ─────────────────────────────────────────────────────────────────
# Uploaded footage is streamed straight to disk, so these are about time and
# size, not memory.
#
# How long a single request may take, start to finish. Node's own default is
# 300s, which silently kills any upload slower than about 700 kB/s partway
# through — a 200 MB import on a home connection. One hour by default.
# REELEEL_REQUEST_TIMEOUT_SECONDS=3600
#
# How long a connection may deliver nothing before the upload is failed as
# UPLOAD_STALLED. This is what distinguishes a slow link from a dead one.
# REELEEL_UPLOAD_STALL_SECONDS=120
#
# Largest single upload accepted, in bytes. Default 16 GiB.
# REELEEL_MAX_UPLOAD_BYTES=17179869184
#
# The browser sends files in chunks so an interruption costs one chunk rather
# than the whole transfer. This caps what one chunk may carry. Default 64 MiB.
# REELEEL_MAX_CHUNK_BYTES=67108864
#
# A resumable upload leaves a scratch file so it can be continued later, even
# across a restart. Abandoned ones are swept after this many hours. Default 48.
# REELEEL_UPLOAD_STALE_HOURS=48
#
# Headers must arrive promptly whatever the body size. Default 60s.
# REELEEL_HEADERS_TIMEOUT_SECONDS=60

# ── Debugging ───────────────────────────────────────────────────────────────
# REELEEL_DEBUG=1
