{
  "name": "reeleel",
  "version": "0.4.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "!apps/mobile"
  ],
  "type": "module",
  "description": "Local-first, FOSS youth-sports video intelligence. Import a game, identify your athlete, get a highlight reel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/reeleel.git"
  },
  "homepage": "https://github.com/profullstack/reeleel#readme",
  "bugs": {
    "url": "https://github.com/profullstack/reeleel/issues"
  },
  "keywords": [
    "video",
    "sports",
    "soccer",
    "highlights",
    "computer-vision",
    "local-first",
    "foss",
    "ffmpeg"
  ],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun run --filter '@reeleel/*' --filter '@profullstack/reeleel' --filter '!@reeleel/mobile' build",
    "start": "HOST=${HOST:-0.0.0.0} bun run --filter @reeleel/web start",
    "cli": "cd apps/cli && bun src/index.ts",
    "dev": "bun run --filter @profullstack/reeleel dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "bun scripts/db-migrate.mjs",
    "db:status": "bun scripts/db-migrate.mjs --status",
    "typecheck": "bun run --filter '@reeleel/*' --filter '@profullstack/reeleel' --filter '!@reeleel/mobile' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "bun run lint && bun run typecheck && bun run test:run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "@profullstack/libsql-pg": "^0.1.4"
  },
  "trustedDependencies": [
    "esbuild",
    "onnxruntime-node"
  ]
}
