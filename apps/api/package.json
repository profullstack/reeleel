{
  "name": "@reeleel/api",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "ReelEel HTTP API (Hono). The same @reeleel/core services the CLI and desktop app use.",
  "license": "MIT",
  "main": "./dist/app.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@reeleel/core": "workspace:*",
    "@reeleel/sports": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
