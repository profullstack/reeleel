{
  "name": "@reeleel/api",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "description": "ReelEel HTTP API (Hono). The same @reeleel/core services the CLI and desktop app use.",
  "license": "MIT",
  "main": "./dist/app.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@profullstack/profile": "0.1.6",
    "@reeleel/core": "workspace:*",
    "@reeleel/sports": "workspace:*",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
