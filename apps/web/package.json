{
  "name": "@reeleel/web",
  "version": "0.4.2",
  "type": "module",
  "private": true,
  "description": "ReelEel web app — Hono JSX server-rendered pages with client-side islands, backed by the ReelEel API.",
  "license": "MIT",
  "scripts": {
    "prebuild": "bun scripts/build-client.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "bun scripts/build-client.mjs --watch & tsx watch src/index.ts",
    "start": "bun dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ."
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@profullstack/footer": "latest",
    "@profullstack/profile": "0.1.6",
    "@profullstack/x402-gateway": "^0.13.1",
    "@reeleel/api": "workspace:*",
    "@reeleel/core": "workspace:*",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
