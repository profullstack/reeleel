{
  "name": "@reeleel/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ReelEel for iOS and Android — native React Native screens over the ReelEel API, built with Expo.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@reeleel/client": "file:../../packages/client",
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.9.3"
  }
}
