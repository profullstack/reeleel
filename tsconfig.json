{
  // Root config for editors and for tools (tsx, vitest) that discover a
  // tsconfig from the workspace root rather than the package they are running.
  // Each package has its own tsconfig.json for actual builds.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": []
}
