# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/

# ── Build output ────────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# Generated by apps/web/scripts/build-client.mjs
apps/web/public/client.js
apps/web/public/client.js.map

# ── Test and tooling caches ─────────────────────────────────────────────────
coverage/
.nyc_output/
.vitest/
.eslintcache
.cache/
.turbo/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ── Agent and editor state ──────────────────────────────────────────────────
# .claude holds agent settings and git worktrees; it is per-machine, not source.
.claude/
.cursor/
.aider*
.vscode/
.idea/
*.swp
*.swo

# ── OS cruft ────────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini

# ── Secrets and local config ────────────────────────────────────────────────
.env
.env.*
!.env.example
.doppler.yaml
*.pem
*.key
!packages/**/*.key.ts

# ── Python CV worker ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Local databases ─────────────────────────────────────────────────────────
# Project databases (project.db) and the machine registry are user data. The
# -wal/-shm siblings come from libSQL's WAL mode and must never be committed
# either — a database without its WAL is a corrupt database.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# ── ReelEel project data ────────────────────────────────────────────────────
# Projects created inside the repo during development. Anchored to the root on
# purpose: a bare `clips/` or `models/` rule would also swallow real source
# directories (the sport-plugin layout has its own models/), and a negation
# cannot re-include anything under an excluded parent.
/projects/
/proxies/
/thumbnails/
/analysis/
/clips/
/exports/
/models/

# Derived artifacts, wherever a project happens to live. These patterns are
# specific to what ReelEel generates, so they cannot collide with source.
thumb_*.jpg
*_[0-9]*p.mp4

# ── Model weights ───────────────────────────────────────────────────────────
# Large, and separately licensed — a FOSS framework does not make its weights
# redistributable. Register them with `reeleel models add` instead.
*.onnx
*.pt
*.pth
*.safetensors
*.ckpt
*.tflite

# ── Media ───────────────────────────────────────────────────────────────────
# Never commit youth-sports footage. Test fixtures must be synthetic and are
# re-included explicitly below.
*.mp4
*.mov
*.mkv
*.webm
*.m4v
*.avi
*.mts
*.m2ts
*.mp3
*.m4a
*.wav
*.aac
fixtures/private/
!**/test/fixtures/**
!**/testdata/**

# ── Local scratch ───────────────────────────────────────────────────────────
tmp/
.tmp/
scratch/
