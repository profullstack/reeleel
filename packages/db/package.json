{
  "name": "@reeleel/db",
  "version": "0.4.0",
  "type": "module",
  "description": "Database clients and forward-only migrations for ReelEel. Project databases are local libSQL files; the machine registry is Postgres when DATABASE_URL is set.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "migrations-pg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "bun ../../scripts/db-migrate.mjs",
    "migrate:status": "bun ../../scripts/db-migrate.mjs --status",
    "test": "vitest run --root ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@profullstack/libsql-pg": "^0.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
